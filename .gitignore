# === Large/generated (ignored) ===
data/
runs/
inputs/
*.parquet
*.csv

# --- Keep small artifacts for comparison (override ignores) ---
!runs/*/outputs/*/run_manifest.json
!runs/*/outputs/*/metrics.json
!runs/*/outputs/*/summary_*.csv
!runs/*/figs/*.pdf
!runs/*/figs/*.png

# Notebooks cache
*.ipynb_checkpoints/

# Logs (usually ignore)
*.log
*.out
*.err

# Env / OS
.env
.DS_Store

# Sensitive licenses/keys
*.lic
*.key
*.pem
